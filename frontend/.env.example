# Leave these unset to go through the Ruby web layer on the same site (the
# default). Set them only to call a backend on another host directly, e.g.
# VITE_API_URL=http://localhost:8000 and VITE_WS_URL=ws://localhost:8000.
# VITE_API_URL=
# VITE_WS_URL=
# From the Clerk dashboard -> API keys ("Publishable key").
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
VITE_SENTRY_DSN=
